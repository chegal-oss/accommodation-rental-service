# Copy this file to .env.docker for local Docker Compose runs.

DOCKER_SECRET_KEY=change-me-in-production
DOCKER_APP_IMAGE=ghcr.io/chegal-oss/accommodation-rental-service:latest
DOCKER_DEBUG=False
DOCKER_ALLOWED_HOSTS=localhost,127.0.0.1
DOCKER_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DOCKER_USE_X_FORWARDED_HOST=True
DOCKER_SESSION_COOKIE_SECURE=False
DOCKER_CSRF_COOKIE_SECURE=False
DOCKER_LOG_LEVEL=INFO

DOCKER_DRF_ANON_THROTTLE_RATE=300/hour
DOCKER_DRF_USER_THROTTLE_RATE=3000/hour
DOCKER_DRF_AUTH_REGISTER_THROTTLE_RATE=20/hour
DOCKER_DRF_AUTH_TOKEN_THROTTLE_RATE=30/hour
DOCKER_DRF_AUTH_REFRESH_THROTTLE_RATE=120/hour

DOCKER_CAPTCHA_ENABLED=False
DOCKER_VITE_CAPTCHA_ENABLED=False
DOCKER_TURNSTILE_SITE_KEY=
DOCKER_TURNSTILE_SECRET_KEY=
DOCKER_CAPTCHA_VERIFY_TIMEOUT=5
DOCKER_VITE_API_BASE_URL=/api/v1

DOCKER_DATABASE_ENGINE=sqlite
DOCKER_SQLITE_DATABASE_PATH=/app/data/db.sqlite3

DOCKER_MYSQL_DATABASE=homerent
DOCKER_MYSQL_USER=homerent
DOCKER_MYSQL_PASSWORD=homerent_password
DOCKER_MYSQL_ROOT_PASSWORD=root_password

DOCKER_POSTGRES_DATABASE=homerent
DOCKER_POSTGRES_USER=homerent
DOCKER_POSTGRES_PASSWORD=homerent_password

DOCKER_CADDY_SITE_ADDRESS=:80
DOCKER_HTTP_PORT=8000
DOCKER_HTTPS_PORT=8443

DOCKER_SUPERUSER_EMAIL=
DOCKER_SUPERUSER_PASSWORD=
DOCKER_SUPERUSER_NAME=Admin
DOCKER_SUPERUSER_PHONE=

DOCKER_SEED_DEMO=False
