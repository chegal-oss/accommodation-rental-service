DOCKER_APP_IMAGE=ghcr.io/chegal-oss/accommodation-rental-service:latest

DOCKER_SECRET_KEY=<strong-django-secret-key>
DOCKER_DEBUG=False
DOCKER_ALLOWED_HOSTS=chegal.duckdns.org
DOCKER_CSRF_TRUSTED_ORIGINS=https://chegal.duckdns.org
DOCKER_USE_X_FORWARDED_HOST=True
DOCKER_SESSION_COOKIE_SECURE=True
DOCKER_CSRF_COOKIE_SECURE=True
DOCKER_LOG_LEVEL=INFO

DOCKER_CAPTCHA_ENABLED=True
DOCKER_TURNSTILE_SECRET_KEY=<cloudflare-turnstile-secret-key>
DOCKER_CAPTCHA_VERIFY_TIMEOUT=5

DOCKER_MYSQL_DATABASE=homerent
DOCKER_MYSQL_USER=homerent
DOCKER_MYSQL_PASSWORD=<strong-mysql-password>
DOCKER_MYSQL_ROOT_PASSWORD=<strong-mysql-root-password>

DOCKER_CADDY_SITE_ADDRESS=chegal.duckdns.org
DOCKER_HTTP_PORT=80
DOCKER_HTTPS_PORT=443

DOCKER_SUPERUSER_EMAIL=<admin-email>
DOCKER_SUPERUSER_PASSWORD=<strong-admin-password>
DOCKER_SUPERUSER_NAME=Admin
DOCKER_SUPERUSER_PHONE=
DOCKER_SUPERUSER_ROLE=landlord

DOCKER_SEED_DEMO=False
